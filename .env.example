NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Existing Vercel VITE_SUPABASE_* settings remain a temporary build fallback.
# Server-only: Toss Place sales integration. Never use the NEXT_PUBLIC_ prefix for
# these values and never expose them in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
TOSSPLACE_MERCHANT_ID=YOUR_TOSSPLACE_MERCHANT_ID
TOSSPLACE_ACCESS_KEY=YOUR_TOSSPLACE_ACCESS_KEY
TOSSPLACE_ACCESS_SECRET=YOUR_TOSSPLACE_ACCESS_SECRET
# Server-only: corporate-card provider. Testbed values must never be reused in
# production, and these variables must never receive the NEXT_PUBLIC_ prefix.
HYPHEN_USER_ID=YOUR_HYPHEN_USER_ID
HYPHEN_HKEY=YOUR_HYPHEN_HKEY
HYPHEN_BASE_URL=https://api.hyphen.im
HYPHEN_ENVIRONMENT=testbed
HYPHEN_CARD_LIST_PATH=CONTRACT_SPECIFIC_CARD_LIST_PATH
HYPHEN_CARD_EVENTS_PATH=CONTRACT_SPECIFIC_APPROVAL_EVENTS_PATH
INTEGRATION_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
# Browser UI provider used during the connection-wizard QA phase. Change to
# hyphen only after the server adapter and testbed credentials are ready.
NEXT_PUBLIC_CARD_CONNECTION_PROVIDER=mock
# Server-only: receipt OCR and structured extraction.
GOOGLE_CLOUD_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_VISION_CREDENTIALS_B64=BASE64_ENCODED_SERVICE_ACCOUNT_JSON
GOOGLE_VISION_API_KEY=YOUR_RESTRICTED_SERVER_API_KEY

# Timefit AX receipt analyzer. Production requires HTTPS and an exact hostname
# entry in TIMEFIT_AX_ALLOWED_HOSTS. Loopback HTTP is development-only.
TIMEFIT_AX_URL=http://127.0.0.1:8351
TIMEFIT_AX_ALLOWED_HOSTS=ax.example.com
TIMEFIT_AX_TRANSPORT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TIMEFIT_AX_REQUEST_TIMEOUT_MS=55000
# Server-only: original receipt archive in Google Drive. The target folder must
# be shared with the service-account client_email. Drive credentials may reuse
# GOOGLE_VISION_CREDENTIALS_B64 when the same service account has Drive access.
GOOGLE_DRIVE_CREDENTIALS_B64=BASE64_ENCODED_SERVICE_ACCOUNT_JSON
GOOGLE_DRIVE_FOLDER_ID=YOUR_SHARED_GOOGLE_DRIVE_FOLDER_ID
# Optional organization-specific override for the Butter Villa receipt archive.
GOOGLE_DRIVE_BUTTER_VILLA_FOLDER_ID=YOUR_BUTTER_VILLA_GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_QUOTA_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
# Recommended for a personal My Drive folder. When set, OAuth is preferred over
# the service account so uploaded files are owned by the connected Drive user.
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_DRIVE_REFRESH_TOKEN=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=YOUR_JSON_SCHEMA_CAPABLE_MODEL
LLM_API_URL=https://api.openai.com/v1/responses
CARD_SYNC_CRON_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
EXPENSE_REMINDER_CRON_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
CARD_RAW_PAYLOAD_RETENTION_DAYS=SET_AFTER_SECURITY_REVIEW
RECEIPT_RETENTION_DAYS=SET_AFTER_LEGAL_REVIEW
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
DASHBOARD_USERNAME=SET_A_SEPARATE_DASHBOARD_USERNAME
DASHBOARD_PASSWORD=SET_A_STRONG_DASHBOARD_PASSWORD
